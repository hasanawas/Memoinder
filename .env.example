# Copy to .env.local. These two values are safe to expose to the browser:
# Row Level Security in the database decides what each user can see.
#
# Local development: run `npx supabase start` and copy API_URL and
# PUBLISHABLE_KEY from its output (or `npx supabase status`).
# Hosted (Phase 5): Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
